{
  "name": "@statefarmins/polygon-labeler",
  "version": "1.0.1",
  "description": "A package for generating a single ideal location to label polygons. This is useful for mapping libraries like Maplibre GL that will generate multiple labels for polygons by default. The package uses an algorithm to find the visual center of polygons and supports grouping features by properties, handling multi-polygons, and viewport clipping for optimal performance.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "nyc mocha",
    "test-with-coverage": "nyc --reporter=text mocha --lines 100",
    "lint": "eslint src --ext .ts",
    "benchmark": "npx tsx src/benchmark/benchmark.ts",
    "prepush": "./npm-pre-push-clean.sh"
  },
  "keywords": [
    "polygon",
    "label",
    "maplibre",
    "geojson",
    "turf",
    "mapbox"
  ],
  "author": "StateFarmIns",
  "homepage": "https://github.com/StateFarmIns/polygon-labeler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StateFarmIns/polygon-labeler.git"
  },
  "bugs": {
    "url": "https://github.com/StateFarmIns/polygon-labeler/issues"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "25.0.3",
    "@types/polylabel": "1.1.3",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "chai": "6.2.2",
    "eslint": "9.39.2",
    "mocha": "11.7.5",
    "nyc": "17.1.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1"
  },
  "dependencies": {
    "@turf/area": "7.3.1",
    "@turf/boolean-point-in-polygon": "7.3.1",
    "@turf/boolean-within": "7.3.1",
    "@turf/combine": "7.3.1",
    "@turf/intersect": "7.3.1",
    "@turf/point-on-feature": "7.3.1",
    "geojson": "0.5.0",
    "polylabel": "2.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
